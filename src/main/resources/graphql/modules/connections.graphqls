type ConnectionRequest {
  id: ID!
  solicitanteId: String!
  receptorId: String!
  mensaje: String
  estado: String!
  createdAt: String
}

type Connection {
  id: ID!
  usuarioMenorId: String!
  usuarioMayorId: String!
  iniciadorId: String!
  estado: String!
  createdAt: String
}

type ConnectionStatus {
  status: String!
  requestId: String
  connectionId: String
}

extend type Query {
  connectionRequests(userId: String!): [ConnectionRequest!]!
  connections(userId: String!): [Connection!]!
  connectionStatus(userId: String!, otherUserId: String!): ConnectionStatus!
}

extend type Mutation {
  sendConnectionRequest(
    solicitanteId: String!
    receptorId: String!
    mensaje: String
  ): ConnectionRequest
  acceptConnection(requestId: String!): Connection
  rejectConnection(requestId: String!): Boolean
  removeConnection(connectionId: String!): Boolean
}
