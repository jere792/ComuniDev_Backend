type Vacancy {
  id: ID!
  companyId: String
  recruiterId: String
  titulo: String!
  descripcion: String
  responsabilidades: [String]
  requisitos: [String]
  tecnologias: [String]
  nivelExperiencia: String
  modalidad: String
  tipoContrato: String
  ubicacion: String
  remuneracion: VacancyRemuneracion
  vacantesDisponibles: Int
  estado: String
  fechaLimite: String
  destacada: Boolean
  postulacionesCount: Int
  createdAt: String
}

type VacancyRemuneracion {
  visible: Boolean
  moneda: String
  minimo: Float
  maximo: Float
  periodo: String
}

extend type Query {
  vacancies(estado: String): [Vacancy!]!
  vacancy(id: ID!): Vacancy
  vacanciesByCompany(companyId: String!): [Vacancy!]!
  # HU-44: "Mis Ofertas" del reclutador. No reemplaza a vacanciesByCompany:
  # ese es por empresa (cualquiera de sus reclutadores), este es por autor.
  vacanciesByRecruiter(recruiterId: String!): [Vacancy!]!
}

extend type Mutation {
  createVacancy(
    companyId: String
    recruiterId: String
    titulo: String!
    descripcion: String
    responsabilidades: [String]
    requisitos: [String]
    tecnologias: [String]
    nivelExperiencia: String
    modalidad: String
    tipoContrato: String
    ubicacion: String
    remuneracion: VacancyRemuneracionInput
    vacantesDisponibles: Int
    fechaLimite: String
  ): Vacancy
  updateVacancy(
    id: ID!
    titulo: String
    descripcion: String
    responsabilidades: [String]
    requisitos: [String]
    tecnologias: [String]
    nivelExperiencia: String
    modalidad: String
    tipoContrato: String
    ubicacion: String
    remuneracion: VacancyRemuneracionInput
    vacantesDisponibles: Int
    fechaLimite: String
    # HU-41: el reclutador puede activar, pausar o cerrar manualmente.
    estado: String
  ): Vacancy
}

input VacancyRemuneracionInput {
  visible: Boolean
  moneda: String
  minimo: Float
  maximo: Float
  periodo: String
}
